rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedInVerified() {
      return request.auth != null
        && request.auth.token.email_verified
        && request.auth.token.email is string;
    }

    function isPlanClarityOnlyUser() {
      return hasWorkItemsAccess()
        && request.auth.token.email != 'amidha111@gmail.com'
        && !firestore.get(/databases/(default)/documents/allowedUsers/$(request.auth.token.email)).data.workItemProducts.hasAny(['klego']);
    }

    function hasWorkItemsAccess() {
      return isSignedInVerified()
        && (
          request.auth.token.email == 'amidha111@gmail.com'
          || (
            firestore.exists(/databases/(default)/documents/allowedUsers/$(request.auth.token.email))
            && firestore.get(/databases/(default)/documents/allowedUsers/$(request.auth.token.email)).data.disabled != true
          )
        );
    }

    match /workItems/{workItemId}/{fileName} {
      allow read: if hasWorkItemsAccess()
        && (!isPlanClarityOnlyUser()
          || firestore.get(/databases/(default)/documents/workItems/$(workItemId)).data.product == 'plan_clarity');
      allow create, update: if hasWorkItemsAccess()
        && (!isPlanClarityOnlyUser()
          || !firestore.exists(/databases/(default)/documents/workItems/$(workItemId))
          || firestore.get(/databases/(default)/documents/workItems/$(workItemId)).data.product == 'plan_clarity')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedInVerified()
        && request.auth.token.email == 'amidha111@gmail.com';
    }
  }
}
