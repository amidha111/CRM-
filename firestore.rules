rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedInVerified() {
      return request.auth != null
        && request.auth.token.email_verified
        && request.auth.token.email is string;
    }

    function isAdmin() {
      return isSignedInVerified()
        && request.auth.token.email == 'amidha111@gmail.com';
    }

    function isWorkItemsOnlyUser() {
      return isAllowedUser()
        && !isAdmin()
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.accessRole == 'work_items_only';
    }

    function isPlanClarityOnlyUser() {
      return isAllowedUser()
        && !isAdmin()
        && !get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.workItemProducts.hasAny(['klego']);
    }

    function isAllowedUser() {
      return isAdmin()
        || (
          isSignedInVerified()
          && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email))
          && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.disabled != true
        );
    }

    function hasFullAccess() {
      return isAllowedUser()
        && !isWorkItemsOnlyUser();
    }

    function hasWorkItemsAccess() {
      return isAllowedUser();
    }

    function createsWithoutRecordNumber() {
      return !request.resource.data.keys().hasAny(['sequenceNumber', 'referenceId']);
    }

    function preservesRecordNumber() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['sequenceNumber', 'referenceId']);
    }

    match /opportunities/{oppId} {
      allow read, delete: if hasFullAccess();
      allow create: if hasFullAccess() && createsWithoutRecordNumber();
      allow update: if hasFullAccess() && preservesRecordNumber();
    }

    match /activities/{activityId} {
      allow read, delete: if hasFullAccess(); // delete only for record cascade
      allow create: if hasFullAccess() && createsWithoutRecordNumber();
      allow update: if false;                     // entries are never edited
    }

    match /contacts/{contactId} {
      allow read, delete: if hasFullAccess();
      allow create: if hasFullAccess() && createsWithoutRecordNumber();
      allow update: if hasFullAccess() && preservesRecordNumber();
    }

    match /accounts/{accountId} {
      allow read, delete: if hasFullAccess();
      allow create: if hasFullAccess() && createsWithoutRecordNumber();
      allow update: if hasFullAccess() && preservesRecordNumber();
    }

    match /workItems/{workItemId} {
      allow read: if hasWorkItemsAccess()
        && (!isPlanClarityOnlyUser() || resource.data.product == 'plan_clarity');
      // Creation is handled by createWorkItemRecord so reference numbers are
      // allocated atomically and cannot be forged by a browser client.
      allow create: if false;
      allow update: if hasWorkItemsAccess()
        && request.resource.data.sequenceNumber == resource.data.sequenceNumber
        && request.resource.data.referenceId == resource.data.referenceId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.createdByName == resource.data.createdByName
        && (!isPlanClarityOnlyUser()
          || (resource.data.product == 'plan_clarity'
            && request.resource.data.product == 'plan_clarity'));
      allow delete: if isAdmin();

      match /events/{eventId} {
        allow read, create: if hasWorkItemsAccess()
          && (!isPlanClarityOnlyUser()
            || getAfter(/databases/$(database)/documents/workItems/$(workItemId)).data.product == 'plan_clarity');
        allow update, delete: if false;
      }
    }

    match /systemCounters/{counterId} {
      allow read, write: if false;
    }

    match /allowedUsers/{email} {
      allow read: if isAdmin()
        || (isSignedInVerified() && request.auth.token.email == email);
      allow create, update: if isAdmin()
        && email != 'amidha111@gmail.com'
        && request.resource.data.email == email;
      allow delete: if isAdmin()
        && email != 'amidha111@gmail.com';
    }
  }
}
